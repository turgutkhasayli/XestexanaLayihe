*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Inter', sans-serif;
  background-color: #f0f2f5;
}

.navbar {
  background-color: #ffffff;
  border-bottom: 1px solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 100;
}

.navbar__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  height: 64px;
  display: flex;
  align-items: center;
  gap: 40px;
}

/* Logo */
.navbar__logo {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  flex-shrink: 0;
}

.navbar__logo-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #4ade80, #22c55e);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.navbar__logo-icon svg {
  width: 18px;
  height: 18px;
}

.navbar__logo-text {
  font-size: 16px;
  font-weight: 700;
  color: #0d0d0d;
}

/* Links */
.navbar__links {
  list-style: none;
  display: flex;
  align-items: center;
  gap: 4px;
  flex: 1;
}

.navbar__link {
  font-size: 14px;
  font-weight: 500;
  color: #4b5563;
  text-decoration: none;
  padding: 6px 12px;
  border-radius: 8px;
  transition: color 0.2s, background 0.2s;
}

.navbar__link:hover {
  color: #1d4ed8;
  background-color: #eff6ff;
}

.navbar__link--active {
  color: #1d4ed8;
  background-color: #dbeafe;
  font-weight: 600;
}

/* Button */
.navbar__btn {
  display: flex;
  align-items: center;
  gap: 7px;
  background-color: #22c55e;
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  padding: 9px 18px;
  border-radius: 8px;
  flex-shrink: 0;
  transition: background 0.2s;
}

.navbar__btn:hover {
  background-color: #16a34a;
}

.navbar__btn svg {
  width: 16px;
  height: 16px;
}


.hero {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  padding: 60px 0 0;
  position: relative;
}

.hero__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px 60px;
}

.hero__title {
  font-size: 48px;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 16px;
  line-height: 1.1;
}

.hero__subtitle {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
  max-width: 520px;
  line-height: 1.6;
}

.stats {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  position: relative;
  top: 0;
}

.stat-card {
  background-color: rgba(255, 255, 255, 0.95);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  border-right: 1px solid #e5e7eb;
}

.stat-card:first-child {
  border-radius: 12px 0 0 0;
}

.stat-card:last-child {
  border-right: none;
  border-radius: 0 12px 0 0;
}

.stat-card__number {
  font-size: 36px;
  font-weight: 700;
  color: #3b82f6;
  line-height: 1;
}

.stat-card__label {
  font-size: 14px;
  color: #6b7280;
  font-weight: 400;
  text-align: center;
}

@media (max-width: 900px) {
  .navbar__links {
    display: none;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .stat-card:nth-child(2) {
    border-right: none;
  }

  .stat-card:nth-child(3) {
    border-right: 1px solid #e5e7eb;
  }

  .stat-card:first-child  { border-radius: 12px 0 0 0; }
  .stat-card:nth-child(2) { border-radius: 0 12px 0 0; }
  .stat-card:last-child   { border-radius: 0; }
}

@media (max-width: 480px) {
  .hero__title {
    font-size: 32px;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
    padding: 0 16px;
  }

  .stat-card__number {
    font-size: 28px;
  }
}
