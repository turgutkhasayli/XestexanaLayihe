*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg-footer: #1a1e2e;
  --text-primary: #e0e4f0;
  --text-muted: #9aa0b8;
  --color-green: #4ade80;
  --color-blue: #60a5fa;
  --color-purple: #c084fc;
  --logo-bg: #2a3050;
  --logo-icon-color: #60d4b0;
  --divider: rgba(255, 255, 255, 0.08);
  --link-hover: #ffffff;
  --font: 'Outfit', sans-serif;
}

body {
  font-family: var(--font);
  background: var(--bg-footer);
}

.footer {
  background-color: var(--bg-footer);
  padding: 48px 0 0;
}

.footer__container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 32px 40px;
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
  gap: 40px;
  align-items: start;
}

.footer__brand {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.footer__logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.footer__logo-icon {
  width: 42px;
  height: 42px;
  background-color: var(--logo-bg);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--logo-icon-color);
  flex-shrink: 0;
}

.footer__logo-icon svg {
  width: 22px;
  height: 22px;
}

.footer__logo-text {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.3px;
}

.footer__description {
  font-size: 13.5px;
  color: var(--text-muted);
  line-height: 1.65;
  font-weight: 300;
}

.footer__col {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.footer__heading {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.4px;
}

.footer__heading--green  { color: var(--color-green); }
.footer__heading--blue   { color: var(--color-blue); }
.footer__heading--purple { color: var(--color-purple); }

.footer__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer__link {
  font-size: 13.5px;
  color: var(--text-muted);
  text-decoration: none;
  font-weight: 400;
  transition: color 0.2s ease;
}

.footer__link:hover {
  color: var(--link-hover);
}

.footer__contact-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.footer__contact-icon {
  font-size: 14px;
  line-height: 1;
}

.footer__divider {
  height: 1px;
  background: var(--divider);
  margin: 0 32px;
}

@media (max-width: 768px) {
  .footer__container {
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .footer__brand {
    grid-column: 1 / -1;
  }
}

@media (max-width: 480px) {
  .footer__container {
    grid-template-columns: 1fr;
  }
}
