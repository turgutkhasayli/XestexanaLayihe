            </div>

        </div>

    </div>

</section>

<!-- CTA -->
<section class="cta">

    <div class="container">

        <div class="cta-box">

            <h2>Hazırsınız?</h2>

            <p>
                İndi həkimlə görüş təyin edin və
                sağlamlığınıza qayğı göstərin
            </p>

            <a href="#contact">Görüş Təyin Et</a>

        </div>

    </div>

</section>

<!-- FOOTER -->
<footer id="contact">

    <div class="container">

        <div class="footer-content">

            <div>
                <h3>MedBook</h3>
                <p>Dünyanın həkim və xəstəxana rezervasiya platforması</p>
            </div>

            <div>
                <h3>Keçidlər</h3>

                <a href="#home">Ana Səhifə</a>
                <a href="#why">Haqqımızda</a>
                <a href="#departments">Şöbələr</a>
            </div>

            <div>
